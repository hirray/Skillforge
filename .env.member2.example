# Local development only. Loaded before .env by the API.
# Keep your teammates’ existing flags in .env unchanged.
RESUMES_SOURCE=real
AI_RESUME_SOURCE=real
AI_REQUIREMENTS_SOURCE=real
AI_MATCH_SOURCE=real
AI_HEALTH_SOURCE=real
AI_JOBMATCH_SOURCE=real
ANALYTICS_SOURCE=real
AI_SERVICE_URL=http://127.0.0.1:8000
MATCH_RANKER=baseline
LLM_PROVIDER=none
MEMBER2_EXTENSIONS=true
# MEMBER2_EXTENSIONS enables local proposed endpoints, pending team contract review.
# RESUME_SIGNING_SECRET is optional in dev; otherwise a per-process key is generated.
