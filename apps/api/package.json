{
  "name": "@skillforge/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:reset": "prisma db push --force-reset && npm run seed",
    "seed": "tsx scripts/seed.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --test-timeout=20000",
    "check:contract": "tsx scripts/check-contract.ts"
  },
  "dependencies": {
    "@skillforge/contract": "*",
    "@prisma/client": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "zod": "^3.22.4",
    "swagger-ui-express": "^5.0.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/yamljs": "^0.2.31",
    "prisma": "^5.0.0",
    "tsx": "^3.12.7",
    "typescript": "^5.0.0",
    "vitest": "^0.34.0",
    "supertest": "^6.3.3"
  }
}
