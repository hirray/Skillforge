{
  "name": "@skillforge/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:reset": "prisma db push --force-reset && npm run seed",
    "seed": "tsx scripts/seed.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --test-timeout=20000",
    "test:authz": "vitest run src/modules/admin/admin.authz.test.ts",
    "check:contract": "tsx scripts/check-contract.ts",
    "seed:member2": "tsx scripts/seed-member2.ts",
    "dev:fake-activity": "tsx scripts/fake-activity.ts",
    "dev:fake-contributions": "tsx scripts/fake-contributions.ts",
    "dev:emit-event": "tsx scripts/emit-event.ts",
    "test:member2": "vitest run src/modules/ai/member2/integration.test.ts --test-timeout=20000 --threads=false",
    "seed:phase4": "tsx scripts/seed-phase4.ts",
    "check:member2-contract": "tsx scripts/check-member2-contract.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "@skillforge/contract": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "multer": "^2.5.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.2",
    "swagger-ui-express": "^5.0.0",
    "yamljs": "^0.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/multer": "^2.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/yamljs": "^0.2.31",
    "prisma": "^5.0.0",
    "supertest": "^6.3.3",
    "tsx": "^3.12.7",
    "typescript": "^5.0.0",
    "vitest": "^0.34.0"
  }
}
