generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  roles     String   // stored as JSON string array
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  skills         UserSkill[]
  learningGoals  LearningGoal[]
  availabilities Availability[]
  education      Education[]
  experience     WorkExperience[]
  certifications Certification[]
  resumes        Resume[]
  projectsOwned  Project[]       @relation("ProjectOwner")
  memberships    ProjectMember[]
  invitations    ProjectInvitation[]
  joinRequests   JoinRequest[]
  portfolio      PortfolioProject[]
  contributions  ContributionEvent[]
  tasksAssigned  Task[]              @relation("TaskAssignee")
  taskComments   TaskComment[]
  mentorProfile  MentorProfile?
  mentorshipRequestsReceived MentorshipRequest[] @relation("MentorUserRequests")
  mentorFeedbackGiven        MentorFeedback[]    @relation("MentorUserFeedback")
  eventsOrganized            HackathonEvent[]    @relation("EventOrganizer")
  eventParticipations        EventParticipant[]
  githubIntegration          GitHubIntegration?
  recruiterMemberships       RecruiterMember[]
  jobApplications            Application[]
}

model Skill {
  id         String       @id @default(uuid())
  name       String       @unique
  category   String
  aliases    SkillAlias[]
  userSkills UserSkill[]
}

model SkillAlias {
  id      String @id @default(uuid())
  alias   String
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id])
}

model UserSkill {
  id      String @id @default(uuid())
  userId  String
  skillId String
  level   String
  user    User   @relation(fields: [userId], references: [id])
  skill   Skill  @relation(fields: [skillId], references: [id])

  // Additive Member 2 fields
  origin   String  @default("manual")
  sourceId String?
}

model LearningGoal {
  id      String @id @default(uuid())
  userId  String
  goal    String
  user    User   @relation(fields: [userId], references: [id])
}

model Availability {
  id      String @id @default(uuid())
  userId  String
  status  String
  user    User   @relation(fields: [userId], references: [id])
}

model Education {
  id          String @id @default(uuid())
  userId      String
  institution String
  degree      String
  user        User   @relation(fields: [userId], references: [id])

  // Additive Member 2 fields
  origin      String  @default("manual")
  sourceId    String?
  detailsJson String?
}

model WorkExperience {
  id      String @id @default(uuid())
  userId  String
  company String
  role    String
  user    User   @relation(fields: [userId], references: [id])

  // Additive Member 2 fields
  origin      String  @default("manual")
  sourceId    String?
  detailsJson String?
}

model Certification {
  id      String @id @default(uuid())
  userId  String
  name    String
  user    User   @relation(fields: [userId], references: [id])

  // Additive Member 2 fields
  origin      String  @default("manual")
  sourceId    String?
  detailsJson String?
}

model Resume {
  id          String   @id @default(uuid())
  userId      String
  url         String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  extractions ResumeExtraction[]

  // Additive Member 2 fields
  fileKey       String?
  fileName      String?
  fileSize      Int?
  hash          String?
  status        String             @default("pending")
  attempts      Int                @default(0)
  lastError     String?
  statusHistory String             @default("[]")
  updatedAt     DateTime           @default(now()) @updatedAt
  @@unique([userId, hash])
}

model ResumeExtraction {
  id       String @id @default(uuid())
  resumeId String
  data     String // JSON string
  resume   Resume @relation(fields: [resumeId], references: [id])

  // Additive Member 2 fields
  confirmedAt   DateTime?
  decisionsHash String?
  decisionsJson String?
  createdAt     DateTime  @default(now())
}

model Project {
  id                 String   @id @default(uuid())
  ownerId            String
  title              String
  description        String   @default("")
  problemStatement   String?
  category           String   @default("Web App")
  type               String?
  outcome            String?
  coverImage         String?
  visibility         String   @default("Public")
  joinMode           String   @default("both")
  memberApprovalMode String   @default("owner")
  minTeamSize        Int      @default(1)
  maxTeamSize        Int      @default(5)
  duration           String?
  targetDate         DateTime?
  status             String   @default("Draft")
  stage              String   @default("Idea")
  budget             Float?
  paid               Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  owner              User                 @relation("ProjectOwner", fields: [ownerId], references: [id])
  requirements       ProjectRequirement[]
  roles              ProjectRole[]
  members            ProjectMember[]
  invitations        ProjectInvitation[]
  joinRequests       JoinRequest[]
  gaps               ProjectGap[]
  handoverNotes      HandoverNote[]
  tasks              Task[]
  milestones         Milestone[]
  resources          ProjectResource[]
  notes              MeetingNote[]
  chatRooms          ChatRoom[]
  completions        ProjectCompletion[]
  verifications      ProjectVerification[]
  activityFeed       ActivityFeedEntry[]
  mentorshipRequests MentorshipRequest[]
  mentorFeedbacks    MentorFeedback[]
  repos              ProjectRepo[]
  contributions      ContributionEvent[]
  eventId            String?
  event              HackathonEvent?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
}

model ProjectRequirement {
  id         String   @id @default(uuid())
  projectId  String
  skillName  String
  level      String   @default("intermediate")
  isOptional Boolean  @default(false)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Additive Member 2 fields
  source     String  @default("manual")
}

model ProjectRole {
  id        String   @id @default(uuid())
  projectId String
  title     String
  openings  Int      @default(1)
  filled    Int      @default(0)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectMember {
  id        String    @id @default(uuid())
  projectId String
  userId    String
  role      String    @default("Contributor")
  status    String    @default("active") // "active" | "left" | "removed"
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  reason    String?
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])
}

model ProjectInvitation {
  id        String   @id @default(uuid())
  projectId String
  inviterId String
  inviteeId String
  role      String   @default("Contributor")
  status    String   @default("pending") // "pending" | "accepted" | "declined" | "expired"
  gapId     String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [inviteeId], references: [id])
  gap       ProjectGap? @relation(fields: [gapId], references: [id])
}

model ProjectGap {
  id                String              @id @default(uuid())
  projectId         String
  roleId            String?
  roleTitle         String?
  skillsJson        String              @default("[]")
  targetProficiency String              @default("intermediate") // "beginner" | "intermediate" | "advanced" | "expert"
  hoursPerWeek      Int                 @default(10)
  status            String              @default("open") // "open" | "filled" | "cancelled"
  origin            String              @default("manual") // "member_left" | "inactive" | "manual"
  departedUserId    String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  handoverNotes     HandoverNote[]
  invitations       ProjectInvitation[]
}

model HandoverNote {
  id                  String      @id @default(uuid())
  projectId           String
  gapId               String?
  authorId            String
  workState           String      @default("")
  unfinishedTasksJson String      @default("[]")
  repoInfo            String?
  decisions           String?
  candidateSummary    String      @default("")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  project             Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  gap                 ProjectGap? @relation(fields: [gapId], references: [id])
}

model JoinRequest {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   @default("Contributor")
  status    String   @default("pending") // "pending" | "approved" | "rejected" | "withdrawn"
  message         String?
  rejectionReason String?
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model Task {
  id                 String        @id @default(uuid())
  projectId          String
  title              String
  description        String?
  priority           String        @default("Medium") // "Low" | "Medium" | "High" | "Critical"
  status             String        @default("To Do")   // "To Do" | "In Progress" | "In Review" | "Done"
  assigneeId         String?
  creatorId          String
  dueDate            DateTime?
  estimatedHours     Float?
  needsReassignment  Boolean       @default(false)
  milestoneId        String?
  dependsOn          String        @default("[]") // JSON string array of task IDs
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  completedAt        DateTime?
  project            Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone          Milestone?    @relation(fields: [milestoneId], references: [id])
  assignee           User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  comments           TaskComment[]
  history            TaskHistory[]
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model TaskHistory {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Milestone {
  id                  String             @id @default(uuid())
  projectId           String
  title               String
  description         String?
  dueDate             DateTime?
  status              String             @default("To Do") // "To Do" | "In Progress" | "Done" | "Overdue"
  progressPercentage  Float              @default(0.0)
  isManualCompletion  Boolean            @default(false)
  completedBy         String?
  completedAt         DateTime?
  completionRationale String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  project             Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks               Task[]
  history             MilestoneHistory[]
}

model MilestoneHistory {
  id          String    @id @default(uuid())
  milestoneId String
  field       String
  oldValue    String?
  newValue    String?
  changedBy   String
  changedAt   DateTime  @default(now())
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
}

model ProjectResource {
  id        String   @id @default(uuid())
  projectId String
  title     String
  type      String   @default("link") // "link" | "file"
  category  String   @default("Other")
  url       String?
  fileKey   String?
  fileName  String?
  fileSize  Int?
  mimeType  String?
  addedBy   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model MeetingNote {
  id        String   @id @default(uuid())
  projectId String
  content   String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ChatRoom {
  id             String    @id @default(uuid())
  projectId      String
  name           String?
  type           String    @default("group") // "group" | "direct"
  participant1Id String?
  participant2Id String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages       Message[]
}

model Message {
  id          String    @id @default(uuid())
  roomId      String
  senderId    String
  content     String
  parentId    String?
  isEdited    Boolean   @default(false)
  isDeleted   Boolean   @default(false)
  attachments String?   // JSON string
  mentions    String?   // JSON string array
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  room        ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model ActivityFeedEntry {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  action    String
  details   String?  // JSON metadata
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  type      String   @default("info")
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model GitHubIntegration {
  id           String    @id @default(uuid())
  userId       String    @unique
  token        String
  username     String?
  scopes       String?   @default("read:user,repo")
  status       String    @default("connected")
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProjectRepo {
  id           String    @id @default(uuid())
  projectId    String
  owner        String
  name         String
  githubRepoId String?
  lastSyncedAt DateTime?
  status       String    @default("active")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, owner, name])
}

model ContributionEvent {
  id            String    @id @default(uuid())
  userId        String
  projectId     String
  detail        String    @default("")
  type          String    @default("commit")
  source        String    @default("github")
  externalId    String?
  externalLogin String?
  referenceUrl  String?
  occurredAt    DateTime  @default(now())
  metadataJson  String?   @default("{}")
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
}

model ProjectCompletion {
  id        String   @id @default(uuid())
  projectId String
  status    String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
}

model ProjectVerification {
  id        String   @id @default(uuid())
  projectId String
  status    String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
}

model Certificate {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  url       String
  createdAt DateTime @default(now())
}

model PortfolioProject {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  user      User     @relation(fields: [userId], references: [id])
}

model Company {
  id                 String            @id @default(uuid())
  name               String
  logo               String?
  overview           String?
  industry           String?
  sizeBand           String?
  website            String?
  locations          String?
  hiringFocus        String?
  verificationStatus String            @default("unverified")
  verificationReason String?
  verifiedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt
  recruiters         RecruiterMember[]
  invites            RecruiterInvite[]
  jobs               Job[]
}

model RecruiterMember {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  role      String   @default("recruiter_member")
  joinedAt  DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
}

model RecruiterInvite {
  id        String   @id @default(uuid())
  companyId String
  email     String
  role      String   @default("recruiter_member")
  token     String   @unique
  status    String   @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Job {
  id               String            @id @default(uuid())
  companyId        String
  title            String
  department       String?
  employmentType   String?           @default("Full-time")
  description      String?           @default("")
  responsibilities String?
  location         String?
  workMode         String            @default("remote")
  salaryMin        Float?
  salaryMax        Float?
  currency         String            @default("USD")
  benefits         String?
  applicationUrl   String?
  status           String            @default("Draft")
  stale            Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requirements     JobRequirement[]
  matches          CandidateMatch[]
  shortlists       Shortlist[]
  applications     Application[]
}

model JobRequirement {
  id             String  @id @default(uuid())
  jobId          String
  skillName      String
  skillId        String?
  importance     String  @default("required")
  minProficiency String  @default("intermediate")
  job            Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model CandidateMatch {
  id        String @id @default(uuid())
  jobId     String
  userId    String
  score     Float
  job       Job    @relation(fields: [jobId], references: [id])

  // Additive Member 2 fields
  explanationJson String   @default("{}")
  runId String?
  inputsSnapshot  String   @default("{}")
  createdAt       DateTime @default(now())
}

model Shortlist {
  id        String @id @default(uuid())
  jobId     String
  userId    String
  job       Job    @relation(fields: [jobId], references: [id])
}

model Application {
  id          String   @id @default(uuid())
  jobId       String
  userId      String
  status      String   @default("submitted")
  resumeId    String?
  coverLetter String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
}

model Report {
  id        String   @id @default(uuid())
  type      String
  status    String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  createdAt DateTime @default(now())
}


// Member 2-owned additive adapters and evidence records.
model AiCandidateProfile {
  userId           String   @id
  name             String
  headline         String   @default("")
  matchingOptIn    Boolean  @default(false)
  recruiterVisible Boolean  @default(false)
  publicSkills     Boolean  @default(true)
  hoursPerWeek     Float    @default(0)
  workMode         String   @default("flexible")
  duration         String   @default("")
  location         String   @default("")
  experienceYears  Float    @default(0)
  profileText      String   @default("")
  updatedAt        DateTime @default(now()) @updatedAt
}

model SkillEvidence {
  id         String   @id @default(uuid())
  userId     String
  skillId    String
  type       String
  sourceType String
  sourceId   String
  occurredAt DateTime @default(now())

  @@unique([userId, skillId, sourceType, sourceId])
  @@index([userId, skillId])
}

model AiJobRequirements {
  jobId             String   @id
  requirementsJson  String   @default("[]")
  minimumExperience Float    @default(0)
  location          String   @default("")
  workMode          String   @default("flexible")
  updatedAt         DateTime @default(now()) @updatedAt
}

model AiMatchRun {
  id             String   @id @default(uuid())
  projectId      String
  actorId        String
  ranker         String   @default("baseline")
  inputsSnapshot String
  resultJson     String
  createdAt      DateTime @default(now())

  @@index([projectId, createdAt])
}

model MatchOutcome {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  roleId    String?
  event     String
  eventKey  String   @unique
  sourceRunId String?
  createdAt DateTime @default(now())

  @@index([projectId, userId])
}

model MetricEvent {
  id          String   @id @default(uuid())
  type        String
  actorId     String?
  projectId   String?
  payloadJson String   @default("{}")
  synthetic   Boolean  @default(false)
  occurredAt  DateTime @default(now())

  @@index([type, occurredAt])
}

model ResumeAccessLog {
  id        String   @id @default(uuid())
  userId    String
  resumeId  String
  action    String
  createdAt DateTime @default(now())
}

// ── Phase 4: Module 27 - Mentors / Expert Layer ────────────────────────────

model MentorProfile {
  id                String              @id @default(uuid())
  userId            String              @unique
  expertiseSkillIds String              // JSON string array e.g. ["React", "Python"]
  domains           String              // JSON string array e.g. ["Web", "AI/ML", "Fintech"]
  availability      String              // e.g. "5 hrs/week"
  formats           String              // JSON string array e.g. ["async_review", "live_call", "check_ins"]
  bio               String?
  active            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests          MentorshipRequest[]
  feedback          MentorFeedback[]
}

model MentorshipRequest {
  id          String         @id @default(uuid())
  projectId   String
  mentorId    String
  scope       String         @default("general") // "general" | "milestone"
  milestoneId String?
  message     String
  status      String         @default("pending") // "pending" | "accepted" | "declined" | "expired"
  expiresAt   DateTime
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mentor      User           @relation("MentorUserRequests", fields: [mentorId], references: [id], onDelete: Cascade)
  profile     MentorProfile? @relation(fields: [mentorId], references: [userId])

  @@index([projectId, mentorId])
  @@index([mentorId, status])
}

model MentorFeedback {
  id          String         @id @default(uuid())
  projectId   String
  mentorId    String
  milestoneId String?
  text        String
  isAdvisory  Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mentor      User           @relation("MentorUserFeedback", fields: [mentorId], references: [id], onDelete: Cascade)
  profile     MentorProfile? @relation(fields: [mentorId], references: [userId])

  @@index([projectId, mentorId])
}

// ── Phase 4: Module 29 - Hackathon / Sprint Mode ───────────────────────────

model HackathonEvent {
  id                String             @id @default(uuid())
  name              String
  description       String
  theme             String
  startsAt          DateTime
  endsAt            DateTime
  rules             String?
  suggestedSkillIds String             // JSON string array e.g. ["React", "FastAPI"]
  status            String             @default("draft") // "draft" | "open" | "running" | "ended" | "archived"
  organizerId       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organizer         User               @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  participants      EventParticipant[]
  projects          Project[]
}

model EventParticipant {
  id             String         @id @default(uuid())
  eventId        String
  userId         String
  lookingForTeam Boolean        @default(true)
  skillsSnapshot String         @default("[]") // JSON string array
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  event          HackathonEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

