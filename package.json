{
  "name": "skillforge",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "npm install && node scripts/setup.js",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:ai\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:ai": "node scripts/run-ai.js",
    "db:reset": "npm run db:reset -w apps/api",
    "seed": "npm run seed -w apps/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node scripts/test-ai.js",
    "check:contract": "npm run check:contract -w apps/api",
    "setup:member2": "node scripts/setup-member2.js",
    "seed:member2": "npm run seed:member2 -w apps/api",
    "dev:fake-activity": "npm run dev:fake-activity -w apps/api",
    "dev:fake-contributions": "npm run dev:fake-contributions -w apps/api",
    "dev:emit-event": "npm run dev:emit-event -w apps/api",
    "eval:matching": "node scripts/eval-matching.js",
    "test:member2": "npm run test:member2 -w apps/api && node scripts/test-ai.js",
    "check:member2-contract": "npm run check:member2-contract -w apps/api",
    "check:member2-migrations": "node scripts/check-migrations.js",
    "check:flows": "node scripts/check-flows.js",
    "check:manuals": "node scripts/check-manuals.js",
    "check:data": "node scripts/check-data.js",
    "docs:manual-pdf": "node scripts/docs-manual-pdf.js",
    "docs:screenshots": "node scripts/docs-screenshots.js"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.72.2",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.1",
    "prettier": "^3.10.1"
  }
}
